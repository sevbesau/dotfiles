# fast focus desktop
cmd - 1 : yabai -m space --focus 4
cmd - 2 : yabai -m space --focus 1
cmd - 3 : yabai -m space --focus 5
cmd - 4 : yabai -m space --focus 2
cmd - 5 : yabai -m space --focus 3

# send window to desktop and follow f ocus
shift + cmd - 1 : yabai -m window --space  4; yabai -m space --focus 4
shift + cmd - 2 : yabai -m window --space  1; yabai -m space --focus 1
shift + cmd - 3 : yabai -m window --space  5; yabai -m space --focus 5
shift + cmd - 4 : yabai -m window --space  2; yabai -m space --focus 2
shift + cmd - 5 : yabai -m window --space  3; yabai -m space --focus 3
