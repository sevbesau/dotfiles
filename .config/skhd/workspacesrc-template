# fast focus desktop
cmd - 1 : yabai -m space --focus {SPACE_CODE}
cmd - 2 : yabai -m space --focus {SPACE_WEB}
cmd - 3 : yabai -m space --focus {SPACE_CONSOLE}
cmd - 4 : yabai -m space --focus {SPACE_CHAT}
cmd - 5 : yabai -m space --focus {SPACE_OTHER}

# send window to desktop and follow f ocus
shift + cmd - 1 : yabai -m window --space  {SPACE_CODE}; yabai -m space --focus {SPACE_CODE}
shift + cmd - 2 : yabai -m window --space  {SPACE_WEB}; yabai -m space --focus {SPACE_WEB}
shift + cmd - 3 : yabai -m window --space  {SPACE_CONSOLE}; yabai -m space --focus {SPACE_CONSOLE}
shift + cmd - 4 : yabai -m window --space  {SPACE_CHAT}; yabai -m space --focus {SPACE_CHAT}
shift + cmd - 5 : yabai -m window --space  {SPACE_OTHER}; yabai -m space --focus {SPACE_OTHER}
