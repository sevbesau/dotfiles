# load workspace keybinds from a separate file since they
# change based on the number of connected displays
.load "workspacesrc"

# focus window
#cmd - h : yabai -m window --focus west
#cmd - j : yabai -m window --focus south
#cmd - k : yabai -m window --focus north
#cmd - l : yabai -m window --focus east

# swap managed window
#cmd + shift - h : yabai -m window --swap west || yabai -m window --display west; yabai -m display --focus west
#cmd + shift - j : yabai -m window --swap south || yabai -m window --display south; yabai -m display --focus south)
#cmd + shift - k : yabai -m window --swap north || yabai -m window --display north; yabai -m display --focus north
#cmd + shift - l : yabai -m window --swap east || yabai -m window --display east; yabai -m display --focus east

# TODO move floating window
# shift + ctrl - a : yabai -m window --move rel:-20:0
# shift + ctrl - s : yabai -m window --move rel:0:20

:: default : ~/.config/borders/bordersrc
:: resize @ : ~/.config/borders/bordersrc resize
cmd + ctrl - r ; resize
resize < escape ; default
resize < h : yabai -m window --resize left:-20:0
resize < j : yabai -m window --resize bottom:0:20
resize < k : yabai -m window --resize top:0:-20
resize < l : yabai -m window --resize right:20:0

# close the current window
cmd + shift - a : yabai -m window --close

# set insertion point in focused container
# ctrl + alt - h : yabai -m window --insert west

# toggle window split type
cmd - s : yabai -m window --toggle split

# float / unfloat window and center on screen
cmd - space : yabai -m window --toggle float --grid 8:8:1:1:6:6

# toggle sticky(+float), picture-in-picture
cmd + alt - p : yabai -m window --toggle sticky --toggle pip

# open terminal
cmd - return : /Applications/kitty.app/Contents/MacOS/kitty -d ~ --single-instance
# open firefox
ctrl + shift - f : /Applications/Firefox.app/Contents/MacOS/firefox 


# make floating window fill screen
# shift + alt - up     : yabai -m window --grid 1:1:0:0:1:1

# make floating window fill left-half of screen
# shift + alt - left   : yabai -m window --grid 1:2:0:0:1:1

